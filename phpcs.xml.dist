<?xml version="1.0"?>
<ruleset name="WPIntegrations">
	<description>WordPress Coding Standards for WPIntegrations plugins.</description>

	<file>.</file>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg value="ps" />
	<arg name="extensions" value="php" />
	<arg name="parallel" value="8" />

	<config name="minimum_wp_version" value="6.2" />
	<config name="testVersion" value="7.4-" />

	<rule ref="WordPress">
		<!-- Short array syntax and modern PHP are fine. -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax" />
		<exclude name="Universal.Arrays.DisallowShortArraySyntax" />
		<!-- PSR-4 file naming (Laravel-style app/), not WP class-file naming. -->
		<exclude name="WordPress.Files.FileName" />
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wpintegrations-connector-for-wc-rd-station" />
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wpi_wcrds" />
				<element value="WPI_WCRDS" />
				<element value="WPIntegrations" />
			</property>
		</properties>
	</rule>
</ruleset>
